node_modules/
dist/

# La PWA compilada que el empaquetador copia junto al servidor.
apps/servidor/pwa/

# El paquete de instalación para Windows. Se regenera con:
#   node herramientas/empaquetar-windows.mjs
#
# Con barra inicial: ancla el patrón a la raíz. Sin ella, git ignora CUALQUIER
# carpeta llamada "entrega" a cualquier profundidad — y se comió en silencio la
# copia de la entrega v0.1.0 que se guardó en historia/.
/entrega/

# El paquete liviano para mandarle al cliente. Se regenera con:
#   node herramientas/empaquetar-correo.mjs
# Lleva adentro el .exe y nssm.exe, que no se versionan.
/entrega-correo/

# Datos de desarrollo: son el log de eventos de pruebas locales, no del negocio.
/datos-dev/

# ─────────────────────────────────────────────────────────────────────────────
# NADA DE DATOS DE UN NEGOCIO REAL EN EL REPOSITORIO
#
# Este repositorio es público. Lo que entra acá queda en el historial de git
# para siempre, y sacarlo después obliga a reescribirlo.
#
# Los archivos que un cliente manda —su catálogo, su planilla de ventas, su
# lista de precios— son SUS datos, no nuestros. Viven en el disco de quien los
# recibe, nunca acá. Para las pruebas hay un catálogo de ejemplo en
# `apps/servidor/pruebas/fijos/`: tiene la misma estructura que un archivo real
# de Excel y los mismos casos raros, con nombres inventados.
# ─────────────────────────────────────────────────────────────────────────────
*.xlsm
/PLANTILLA-CATALOGO.xlsx
/datos-ejemplo/catalogo-del-excel.json
*-del-cliente.xlsx
/datos/

# Lo que genera el extractor a partir del Excel. Se regenera con:
#   python3 herramientas/extraer-catalogo-excel.py
datos-ejemplo/catalogo-del-excel.json

# Íconos derivados del logo. Se regeneran con:
#   python3 herramientas/generar-iconos.py
apps/pwa/public/iconos/

.DS_Store
*.log
